  "scripts": {
    "dev": "pnpm build:css && concurrently -k -n css,ladle \"pnpm:watch:css\" \"pnpm:playground\"",
    "watch": "pnpm build && concurrently -k -n ts,css \"pnpm:watch:ts\" \"pnpm:watch:css\"",
    "watch:ts": "node scripts/watch-ts.mjs",
    "watch:css": "node scripts/watch-css.mjs",
    "playground": "ladle serve -p 61000",
    "playground:build": "ladle build",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 pnpm build:ts && pnpm build:css",
    "build:ts": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "build:css": "tailwindcss -i src/tokens/tokens.css -o dist/styles.css --minify && node scripts/unwrap-layers.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm lint && node scripts/check-docs.mjs && pnpm typecheck && pnpm test && pnpm build",
    "audit": "node scripts/audit-usage.mjs",
    "changeset": "changeset",
    "ci:publish": "changeset publish"
  },
