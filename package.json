{
  "name": "@neuronection/assistant-ui",
  "version": "0.1.0",
  "description": "Shared React component library for the Assistant family (career-, study-, health-assistant). Family look by default, app-flavored via CSS-variable tokens.",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neuronection/assistant-ui.git"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./badge": {
      "types": "./dist/badge.d.ts",
      "import": "./dist/badge.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "import": "./dist/button.js"
    },
    "./card": {
      "types": "./dist/card.d.ts",
      "import": "./dist/card.js"
    },
    "./confirmation-modal": {
      "types": "./dist/confirmation-modal.d.ts",
      "import": "./dist/confirmation-modal.js"
    },
    "./empty-state": {
      "types": "./dist/empty-state.d.ts",
      "import": "./dist/empty-state.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "import": "./dist/input.js"
    },
    "./modal": {
      "types": "./dist/modal.d.ts",
      "import": "./dist/modal.js"
    },
    "./popover": {
      "types": "./dist/popover.d.ts",
      "import": "./dist/popover.js"
    },
    "./portal": {
      "types": "./dist/portal.d.ts",
      "import": "./dist/portal.js"
    },
    "./spinner": {
      "types": "./dist/spinner.d.ts",
      "import": "./dist/spinner.js"
    },
    "./theme-scope": {
      "types": "./dist/theme-scope.d.ts",
      "import": "./dist/theme-scope.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip.d.ts",
      "import": "./dist/tooltip.js"
    }
  },
  "scripts": {
    "dev": "pnpm build:css && concurrently -k -n css,ladle \"pnpm:watch:css\" \"pnpm:playground\"",
    "playground": "ladle serve -p 61000",
    "playground:build": "ladle build",
    "watch:css": "tailwindcss -i src/tokens/tokens.css -o dist/styles.css --watch",
    "build": "pnpm build:ts && pnpm build:css",
    "build:ts": "tsup",
    "build:css": "tailwindcss -i src/tokens/tokens.css -o dist/styles.css --minify && node scripts/unwrap-layers.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "audit": "node scripts/audit-usage.mjs",
    "changeset": "changeset",
    "ci:publish": "changeset publish"
  },
  "peerDependencies": {
    "lucide-react": ">=0.460.0 <2.0.0",
    "react": ">=18.0.0 <20.0.0",
    "react-dom": ">=18.0.0 <20.0.0"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-popover": "^1.1.5",
    "@radix-ui/react-slot": "^1.3.2",
    "@radix-ui/react-tooltip": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.0",
    "@changesets/cli": "^2.29.0",
    "@eslint/js": "^10.0.1",
    "@ladle/react": "^5.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^9.1.2",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jest-axe": "^9.0.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.31.0",
    "postcss": "^8.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22"
  }
}
